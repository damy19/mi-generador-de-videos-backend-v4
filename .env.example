# Copiá este archivo como .env y completá los valores. Nunca subas el .env al repositorio.

# Servidor
PORT=3000

# Base de datos (Supabase / PostgreSQL)
# DATABASE_URL: conexión con pooler (la usa la app). DIRECT_URL: conexión directa (la usa Prisma para migraciones).
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USUARIO:CONTRASEÑA@HOST:5432/postgres

# Supabase Auth (la service role key solo se usa en el backend)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# fal.ai (generación de video)
FAL_KEY=
FAL_POLL_INTERVAL_MS=15000
FAL_POLL_MAX_MS=1960000
FAL_POLL_MAX_ERRORS=5

# Paddle (pagos). Las claves que empiezan con test_ usan el sandbox.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET_KEY=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_CREATOR=
PADDLE_PRICE_PRO=
PADDLE_PRICE_BUSINESS=

# Kling (opcional, image-to-video experimental)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=
KLING_AUTH_MODE=
